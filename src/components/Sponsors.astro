---
import { Image } from 'astro:assets';
import muesLogo from '../assets/mues-logo.png';
---

<section id="sponsors" class="section" aria-labelledby="sponsors-heading">
  <div class="section-head">
    <h2 id="sponsors-heading">Our Sponsors</h2>
  </div>
  <ul class="sponsor-grid">
    <li class="tile sponsor__logo">
      <Image src={muesLogo} alt="Metropolitan Undergraduate Engineering Society (MUES)" width={220} densities={[1, 2]} />
    </li>
  </ul>
</section>

<style>
  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 32px;
    list-style: none;
  }
  .sponsor__logo {
    display: grid;
    place-items: center;
    min-height: 156px;
    padding: 24px;
    background: #fff;
  }
  @media (max-width: 600px) {
    .sponsor-grid {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }
  }
</style>
