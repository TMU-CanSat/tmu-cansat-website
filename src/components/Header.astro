---
import { Image } from 'astro:assets';
import { nav } from '../data/site';
import logo from '../assets/logo.png';
---

<header class="topbar">
  <div class="container topbar__inner">
    <a href="/" class="brand">
      <Image src={logo} alt="" width={36} height={36} densities={[1, 2, 3]} quality={90} />
      <span>TMU CanSat</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {
          nav.map((item) =>
            'children' in item && item.children ? (
              <li class="nav__dropdown">
                <a href={item.href} aria-haspopup="true" aria-expanded="false">
                  {item.label}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </a>
                <ul class="nav__menu">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(4, 6, 13, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 1.15rem;
    white-space: nowrap;
  }
  .nav {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav a:hover {
    color: var(--white);
    background: rgba(251, 251, 251, 0.06);
  }

  /* ----- Dropdown ----- */
  .nav__dropdown {
    position: relative;
  }
  .nav__dropdown > a svg {
    transition: transform 0.2s ease;
  }
  .nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    translate: -50% 0;
    min-width: 230px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: rgba(10, 14, 26, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    display: grid;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }
  /* Keep the dropdown open while hovering the gap between trigger and menu */
  .nav__menu::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }
  .nav__dropdown:hover .nav__menu,
  .nav__dropdown:focus-within .nav__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__dropdown:hover > a svg,
  .nav__dropdown:focus-within > a svg {
    transform: rotate(180deg);
  }
  .nav__menu a {
    border-radius: 9px;
    padding: 10px 14px;
    white-space: nowrap;
    font-size: 0.9rem;
    border-left: 2px solid transparent;
  }
  .nav__menu a:hover {
    color: var(--yellow);
    background: rgba(250, 218, 0, 0.07);
    border-left-color: var(--yellow);
    border-radius: 2px 9px 9px 2px;
  }

  @media (max-width: 960px) {
    .topbar__inner {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-top: 12px;
      padding-bottom: 8px;
    }
    .topbar nav {
      width: 100%;
      overflow-x: auto;
    }
    .nav a {
      white-space: nowrap;
      padding: 6px 10px;
    }
    /* No hover on touch: About Us works as a plain link, teams are reachable from the page */
    .nav__dropdown > a svg {
      display: none;
    }
    .nav__menu {
      display: none;
    }
  }
</style>
