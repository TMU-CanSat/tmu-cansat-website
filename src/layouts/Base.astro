---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import stars from '../assets/stars.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TMU CanSat',
  description = "Toronto Metropolitan University's student satellite development team. Designing, building, and launching CanSats since 2006.",
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.tmucansat.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = await getImage({ src: stars, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 90 });
const socialImageUrl = new URL(socialImage.src, siteUrl);
const socialImageAlt = 'TMU CanSat logo against a navy starfield with blue and yellow waves';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TMU CanSat" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content="#04060d" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,500;0,600;0,700;1,600;1,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
