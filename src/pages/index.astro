---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Socials from '../components/Socials.astro';
import AwardsTimeline from '../components/AwardsTimeline.astro';
import Sponsors from '../components/Sponsors.astro';
import { email } from '../data/site';
import stars from '../assets/stars.png';
import teamPhoto from '../assets/team_photo.jpg';
import logo from '../assets/logo.png';

const workshops = [
  {
    subject: 'Analysis',
    title: 'Finite Element Analysis',
    body: 'Students model loads, stress, and vibrations in aerospace components, exploring FEA fundamentals and modal analysis with ANSYS Mechanical.',
    tools: 'ANSYS Mechanical',
  },
  {
    subject: 'Communications',
    title: 'Telemetry & Ground Station',
    body: 'A complete wireless telemetry link brings sensor data to life, introducing students to embedded systems and live data transmission.',
    tools: 'XBee radios · Raspberry Pi · Sensors',
  },
  {
    subject: 'Design & programming',
    title: 'Intro to Satellites',
    body: 'A CanSat prototype makes satellite concepts tangible, alongside practical experience with parametric CAD and programming.',
    tools: 'Onshape · Arduino IDE',
  },
  {
    subject: 'Build & launch',
    title: 'STECI CanSat Competition',
    body: 'Through the Space Tech Through Education Initiative, teams of four to five students design, build, and launch a mini-satellite payload.',
    tools: 'Payload packaging · System integration · Telemetry',
  },
];
---

<Base>
  <Header />

  <main id="top" class="container">
    <!-- ===== Hero ===== -->
    <section class="bento hero" aria-label="Introduction">
      <div class="tile tile--flush span-2 hero__main">
        <Image src={stars} alt="" class="hero__bg" widths={[800, 1400]} sizes="(max-width: 600px) 100vw, 600px" loading="eager" />
        <div class="hero__content">
          <h1>TMU<br /><span>CanSat</span></h1>
          <p>Toronto Metropolitan University's Satellite Development Team</p>
        </div>
      </div>

      <div class="tile tile--flush span-2 photo">
        <Image
          src={teamPhoto}
          alt="TMU CanSat team members holding a Canadian flag beside their CanSat rocket"
          widths={[600, 900, 1200]}
          sizes="(max-width: 960px) 100vw, 600px"
          loading="eager"
        />
      </div>

      <div class="tile span-4 intro">
        <p>
          We're a group of TMU students who design and build small satellite payloads for the annual CanSat competition.
          Since the team started in 2006, we've learned by making prototypes, testing them, and figuring out what needs
          to change before launch. In 2026, we placed #1 in Canada.
        </p>
      </div>

    </section>

    <!-- ===== About ===== -->
    <section id="about" class="section">
      <div class="section-head">
        <h2>About Us</h2>
      </div>
      <div class="bento">
        <article class="tile span-4 about">
          <p>
            We're a student design team at Toronto Metropolitan University, turning classroom concepts into working
            aerospace systems. Our CanSats combine sensors, microcontrollers, and custom structures in a compact payload
            built to meet strict size and weight limits.
          </p>
          <p>
            From early prototypes to launch day, we test for reliable communication, live data transmission, and safe
            descent. We share that experience through workshops and student competitions that make space engineering
            more accessible.
          </p>
        </article>
      </div>
    </section>

    <!-- ===== Awards ===== -->
    <section id="awards" class="section">
      <div class="section-head">
        <h2>Awards</h2>
      </div>
      <AwardsTimeline />
    </section>

    <section id="outreach" class="section" aria-labelledby="outreach-heading">
      <div class="section-head outreach-heading">
        <h2 id="outreach-heading">Beyond the competition</h2>
        <p>Practical workshops and student projects bring aerospace engineering to the wider community.</p>
      </div>
      <div class="bento bento--compact">
        {workshops.map((workshop) => (
          <article class="tile span-2 workshop">
            <span class="eyebrow">{workshop.subject}</span>
            <h3>{workshop.title}</h3>
            <p>{workshop.body}</p>
            <span class="workshop__tools">{workshop.tools}</span>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== Sponsors ===== -->
    <Sponsors />

    <!-- ===== Contact ===== -->
    <section id="contact" class="section">
      <div class="section-head">
        <h2>Contact</h2>
      </div>
      <div class="bento">
        <div class="tile span-2 row-2 contact">
          <div class="contact__identity">
            <address class="contact__address">
              <p class="contact__org">Toronto Metropolitan University</p>
              <p class="contact__org">Attn: TMU CanSat</p>
              <p>Kerr Hall East - Room 40D</p>
              <p>350 Victoria Street</p>
              <p>Toronto, ON M5B 2K3</p>
              <p><span aria-hidden="true">🇨🇦</span> Canada</p>
            </address>
            <Image src={logo} alt="TMU CanSat logo" width={80} height={80} densities={[1, 2]} quality={90} class="contact__logo" />
          </div>
          <div class="contact__item">
            <p>
              Have a question? Get in touch by email or through our socials.
            </p>
          </div>
          <div class="contact__actions">
            <Socials />
            <a href={`mailto:${email}`} class="btn btn--primary">
              Get in touch
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          </div>
        </div>
        <div class="tile tile--flush span-2 row-2 map">
          <iframe
            title="Map showing Toronto Metropolitan University"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5773.0822274818665!2d-79.38210845182277!3d43.6577148378784!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89d4cb35431c1395%3A0xe8ed8bd69125d6f4!2sToronto%20Metropolitan%20University!5e0!3m2!1sen!2sca!4v1735095818170!5m2!1sen!2sca"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
    </section>
  </main>

</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    grid-auto-rows: auto;
  }
  .hero__main {
    display: flex;
    min-height: 460px;
    align-items: flex-end;
    background: var(--black);
  }
  .hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    /* Show only the left half (stars + waves) so the baked-in logo stays out from behind the title */
    width: 340%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    opacity: 0.7;
  }
  .hero__main::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(1, 1, 1, 0.92) 10%, rgba(1, 1, 1, 0.1) 70%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding: 32px;
    display: grid;
    gap: 14px;
  }
  .hero h1 {
    font-size: clamp(3.4rem, 8vw, 5.8rem);
    font-weight: 700;
    line-height: 0.92;
    text-transform: uppercase;
  }
  .hero h1 span {
    color: var(--yellow);
  }
  .hero__content p {
    color: #d8d7d3;
    max-width: 380px;
    font-size: 1.05rem;
  }

  .photo {
    min-height: 320px;
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro {
    display: flex;
    align-items: center;
    padding-block: 28px;
  }
  .intro p {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.45;
  }



  /* ---------- About ---------- */
  .about {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .about p {
    color: #cfcec9;
    font-size: 1.08rem;
  }
  .workshop {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .workshop h3 {
    font-size: 1.6rem;
    line-height: 1.2;
  }
  .workshop p {
    color: var(--muted);
  }
  .workshop__tools {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: #cfcec9;
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .outreach-heading {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ---------- Contact ---------- */
  .contact {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .contact__identity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 20px;
  }
  .contact__address {
    display: grid;
    gap: 4px;
    font-family: var(--font-body);
    font-style: normal;
  }
  .contact__org {
    color: var(--yellow);
    font-weight: 600;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .contact__actions .btn {
    white-space: nowrap;
  }
  .contact__item {
    display: grid;
    gap: 4px;
  }
  .contact__item p {
    font-size: 1.05rem;
  }
  .map {
    min-height: 340px;
  }
  .map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.4) contrast(1.05);
  }


  @media (max-width: 960px) {
    .photo {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 600px) {
    .hero__main {
      min-height: 380px;
    }
    .hero__content {
      padding: 28px 20px;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
    .contact__identity {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact__logo {
      grid-row: 1;
    }
  }
</style>
