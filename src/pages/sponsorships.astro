---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Sponsors from '../components/Sponsors.astro';
import { email } from '../data/site';
import fieldPhoto from '../assets/team_photo.jpg';
import teamPhoto from '../assets/team_photo_2.jpg';
import launchPhoto from '../assets/team_photo_3.png';

const photos = [
  { src: fieldPhoto, alt: 'TMU CanSat team members with their rocket and a Canadian flag at the launch field' },
  { src: teamPhoto, alt: 'CanSat team members presenting their satellite hardware at a competition' },
  { src: launchPhoto, alt: 'CanSat team members holding two rockets and a Canadian flag' },
];
---

<Base title="Sponsorships" description="Help TMU CanSat build, launch, and inspire future engineers. Download our 2026–27 sponsorship package and get in touch.">
  <Header />
  <main class="container">
    <header class="page-heading">
      <h1>Sponsorships</h1>
    </header>

    <section id="why-sponsor" class="section" aria-labelledby="why-sponsor-heading">
      <div class="section-head">
        <h2 id="why-sponsor-heading">Why sponsor us?</h2>
      </div>

      <div class="sponsorship-photos">
        {photos.map((photo) => (
          <div class="sponsorship-photo">
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[450, 750, 1200]}
              sizes="(max-width: 600px) calc(100vw - 64px), (max-width: 1328px) 30vw, 400px"
              loading="eager"
            />
          </div>
        ))}
      </div>

      <div class="bento bento--compact sponsorship-copy">
        <div class="tile span-2 sponsorship-intro">
          <p>
            Help students turn classroom knowledge into working satellite systems. Your support puts hardware,
            materials, and tools in the hands of our team and helps bring our designs to international competition.
          </p>
          <p>
            Connect with future engineers through hands-on projects, student workshops, and outreach. Our sponsorship
            package outlines opportunities to showcase your brand through social media, team apparel, and competition materials.
          </p>
        </div>
        <div class="tile span-2 sponsorship-actions">
          <span class="eyebrow">2026–27 season</span>
          <p>Support the team through financial contributions, tools, materials, software, or services. Explore the official package to find out how your organization can get involved.</p>
          <div class="sponsorship-buttons">
            <a
              href="/downloads/tmu-cansat-2026-27-sponsorship-package.pdf"
              class="btn btn--primary"
              download="TMU CanSat - 2026-27 Sponsorship Package.pdf"
              aria-label="Download 2026–27 sponsorship package (PDF)"
            >
              <span>Download package</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" />
              </svg>
            </a>
            <a href={`mailto:${email}?subject=${encodeURIComponent('2026–27 TMU CanSat Sponsorship')}`} class="btn">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <Sponsors />
  </main>
</Base>

<style>
  .sponsorship-photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 32px;
    border-bottom: 1px solid var(--line);
  }
  .sponsorship-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .sponsorship-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sponsorship-intro,
  .sponsorship-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .sponsorship-copy p {
    max-width: 62ch;
    color: var(--muted);
    line-height: 1.75;
  }
  .sponsorship-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
  }
  .sponsorship-buttons svg {
    flex-shrink: 0;
  }
  @media (max-width: 600px) {
    .sponsorship-photos {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }
  }
</style>
